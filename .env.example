# ==============================================================================
# Transcribe Core Backend - Environment Configuration
# Copy to .env and adjust variables as needed
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
# Host interface to bind on (127.0.0.1 for local/reverse-proxy, 0.0.0.0 for docker)
BIND_HOST=127.0.0.1
# Port the backend listens on inside the container
PORT=8080
# External port mapped on the host machine
APP_PORT=8080
# Directory to store static downloadable assets (e.g. APK, source zips)
DOWNLOADS_DIR=/app/downloads

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (DUAL-ENGINE SUPPORT)
# ------------------------------------------------------------------------------
# Engine choices: 'postgres' (recommended for multi-user) or 'sqlite' (zero-RAM footprint)
DB_DRIVER=postgres

# PostgreSQL Settings (Used when DB_DRIVER=postgres)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=transcribe_secure_pass_replace_in_production
DB_NAME=transcribe
DB_SSLMODE=disable
# Optional external port for PostgreSQL on host (leave blank to keep internal only)
DB_EXTERNAL_PORT=5432
# Direct DSN override (if set, overrides DB_HOST, DB_USER, etc.)
# DB_DSN=postgres://postgres:password@127.0.0.1:5432/transcribe?sslmode=disable

# SQLite Settings (Used when DB_DRIVER=sqlite)
# If running on a cheap $2-$4/month VPS with < 1GB RAM, switch DB_DRIVER=sqlite!
SQLITE_PATH=/data/transcribe.db

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Cryptographic secret key for signing HMAC-SHA256 JWT access and refresh tokens
# Generate with: openssl rand -base64 32 (min 32 bytes)
JWT_SECRET=generate_a_random_32_byte_secret_key_here

# Google OAuth 2.0 Web Client ID for Google Credential Manager validation
GOOGLE_CLIENT_ID=709542679592-lprl5ob7uv2ktin74idhg4347n8urbuk.apps.googleusercontent.com

# Allow email/password authentication (set 'false' in production to enforce Google OAuth)
ALLOW_PASSWORD_AUTH=false

# Secret token for authenticating X-Admin-Key header on /api/v1/admin/vouchers
ADMIN_SECRET=generate_a_secure_admin_secret_key_here

# ------------------------------------------------------------------------------
# 4. AI GATEWAY (GEMINI / 9ROUTER)
# ------------------------------------------------------------------------------
# URL for OpenAI-compatible completions endpoint
# Use host.docker.internal:20128 if 9router runs on host, or public https://...
NINEROUTER_URL=http://127.0.0.1:20128/v1
NINEROUTER_KEY=

# Multimodal LLM model used for streaming audio transcription & summarization
GEMINI_MODEL=ag/gemini-3.8-flash

# ------------------------------------------------------------------------------
# 5. DISASTER RECOVERY & OFF-SITE BACKUP
# ------------------------------------------------------------------------------
# Symmetric AES-256-CBC passphrase for encrypting backup archives
BACKUP_ENCRYPTION_KEY=
