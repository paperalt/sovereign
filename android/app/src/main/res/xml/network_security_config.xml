<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production Base Config: Strict TLS with system-only certificate anchors -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Development Domain Overrides: Allow cleartext only for dev nodes/emulators -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">43.156.217.174</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>

    <!-- Debug Overrides: Allow user certificates only on debug APK builds -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
